import pandas as pd

# Create a DataFrame
df = pd.DataFrame({
    'ID': [1, 2, 3, 4, 5, 6],
    'Product_name': ['Pen', 'Book', 'Pen', 'Pencil', 'Book', 'Pen'],
    'State': ['Tamil Nadu', 'Kerala', 'Tamil Nadu',
              'Kerala', 'Karnataka', 'Tamil Nadu'],
    'Sales': [10, 20, 15, 25, 30, 10]
})

print("Original Data:")
print(df)

# Ungrouped Frequency Distribution
print("\nUngrouped Frequency Distribution:")
print(df['Sales'].value_counts().sort_index())

# Grouped Frequency Distribution
print("\nGrouped Frequency Distribution:")
print(df.groupby('Product_name')['Sales'].sum())

# Cumulative Frequency Distribution
freq = df['Sales'].value_counts().sort_index()
print("\nCumulative Frequency:")
print(freq.cumsum())

# Relative Frequency Distribution
print("\nRelative Frequency:")
print(freq / freq.sum())

# State-wise Frequency Distribution
print("\nState-wise Frequency:")
print(df['State'].value_counts())

