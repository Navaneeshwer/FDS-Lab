import pandas as pd
import numpy as np
from scipy.stats import iqr

# Create DataFrame
data = {
    'Subject_Marks': [72, 73, 72, 72, 73]
}

df = pd.DataFrame(data)

print("DataFrame:")
print(df)

# Measures of Centre
print("\nMean:")
print(df['Subject_Marks'].mean())

print("\nMedian:")
print(df['Subject_Marks'].median())

print("\nMode:")
print(df['Subject_Marks'].mode())

# Measures of Variability
print("\nStandard Deviation:")
print(df['Subject_Marks'].std())

print("\nVariance:")
print(df['Subject_Marks'].var())

print("\nInterquartile Range:")
print(iqr(df['Subject_Marks']))

