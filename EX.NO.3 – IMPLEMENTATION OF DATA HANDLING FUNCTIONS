import pandas as pd

# Create a DataFrame
data = {
    'Name': ['Arun', 'Bala', 'Cathy', 'David', 'Eva'],
    'Age': [20, 21, None, 22, 100],
    'Marks': [85, 90, 75, None, 95]
}

df = pd.DataFrame(data)

print("Original DataFrame:")
print(df)

# Detect missing values
print("\nMissing Values:")
print(df.isnull())

# Fill missing values
df['Age'] = df['Age'].fillna(df['Age'].mean())
df['Marks'] = df['Marks'].fillna(df['Marks'].mean())

print("\nAfter Filling Missing Values:")
print(df)

# Data transformation using apply()
df['Marks'] = df['Marks'].apply(lambda x: x + 5)

print("\nAfter Adding 5 Marks:")
print(df)

# String operations
df['Name'] = df['Name'].str.upper()

print("\nNames in Uppercase:")
print(df['Name'])

# Display statistical information
print("\nStatistical Description:")
print(df.describe())

# Filter records
print("\nStudents with Marks Greater than 85:")
print(df[df['Marks'] > 85])

